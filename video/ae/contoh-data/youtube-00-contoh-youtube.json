  "scenes": [
    {
      "id": 1,
      "type": "hook",
      "dur": 11,
      "onScreen": "Kenapa susah *fokus* kerja?",
      "vo": "Pernah duduk di depan laptop berjam-jam, tapi kerjaan nggak maju-maju? Kamu nggak sendirian. Di video ini kita bahas tiga penyebab susah fokus, dan cara sederhana untuk mengatasinya satu per satu.",
      "props": {
        "kicker": "Panduan",
        "sub": "3 penyebab dan cara mengatasinya"
      },
      "rawType": "hook",
      "start": 0,
      "end": 14.349,
      "needsConfirm": false
    },
    {
      "id": 2,
      "type": "bab",
      "dur": 3,
      "vo": "Bagian pertama, gangguan dari luar.",
      "props": {
        "title": "Gangguan dari luar"
      },
      "rawType": "bab",
      "start": 14.349,
      "end": 17.778,
      "needsConfirm": false
    },
    {
      "id": 3,
      "type": "poin",
      "dur": 7,
      "onScreen": "Notifikasi *memecah* konsentrasi",
      "vo": "Setiap kali HP berbunyi, perhatian kamu pindah. Walaupun cuma sebentar, butuh waktu untuk kembali ke titik semula.",
      "props": {
        "sub": "Satu bunyi kecil bisa menghapus beberapa menit fokus."
      },
      "rawType": "poin",
      "start": 17.778,
      "end": 26.794,
      "needsConfirm": false
    },
    {
      "id": 4,
      "type": "daftar",
      "dur": 9,
      "onScreen": "Cara meredam gangguan",
      "vo": "Ada empat cara sederhana. Aktifkan mode fokus di HP. Tutup tab yang tidak dipakai. Pakai headphone. Dan kabari rekan kerja kalau kamu sedang tidak bisa diganggu.",
      "props": {
        "items": [
          {
            "text": "Aktifkan *mode fokus* di HP",
            "icon": "alert",
            "onWord": "mode"
          },
          {
            "text": "Tutup tab yang tidak dipakai",
            "icon": "x",
            "onWord": "tutup"
          },
          {
            "text": "Pakai headphone",
            "icon": "user",
            "onWord": "headphone"
          },
          {
            "text": "Kabari rekan kerja",
            "icon": "chat",
            "onWord": "kabari"
          }
        ]
      },
      "rawType": "daftar",
      "start": 26.794,
      "end": 38.934,
      "needsConfirm": false
    },
    {
      "id": 5,
      "type": "bab",
      "dur": 3,
      "vo": "Bagian kedua, tugas yang terlalu besar.",
      "props": {
        "title": "Tugas yang terlalu besar"
      },
      "rawType": "bab",
      "start": 38.934,
      "end": 42.514,
      "needsConfirm": false
    },
    {
      "id": 6,
      "type": "angka",
      "dur": 7,
      "vo": "Pecah pekerjaan besar jadi sesi pendek. Misalnya lima puluh menit kerja, lalu sepuluh menit istirahat.",
      "props": {
        "value": "50 menit",
        "label": "satu sesi kerja, lalu *istirahat 10 menit*",
        "kicker": "Coba ini"
      },
      "rawType": "angka",
      "start": 42.514,
      "end": 50.233,
      "needsConfirm": false
    },
    {
      "id": 7,
      "type": "foto",
      "dur": 7,
      "onScreen": "Tulis *satu langkah* berikutnya",
      "vo": "Sebelum mulai, tulis satu langkah kecil yang mau kamu selesaikan. Langkah kecil lebih mudah dimulai daripada tugas besar.",
      "props": {
        "image": "video/youtube-00/foto/contoh.jpg",
        "sub": "Bukan \"selesaikan laporan\", tapi \"tulis paragraf pertama\"."
      },
      "rawType": "foto",
      "start": 50.233,
      "end": 59.052,
      "needsConfirm": false
    },
    {
      "id": 8,
      "type": "bab",
      "dur": 3,
      "vo": "Bagian ketiga, kebiasaan multitasking.",
      "props": {
        "title": "Kebiasaan multitasking"
      },
      "rawType": "bab",
      "start": 59.052,
      "end": 62.841,
      "needsConfirm": false
    },
    {
      "id": 9,
      "type": "banding",
      "dur": 8,
      "onScreen": "Multitasking itu cepat?",
      "vo": "Banyak yang merasa multitasking itu cepat. Padahal faktanya, pindah-pindah tugas justru membuat pekerjaan lebih lama selesai.",
      "props": {
        "left": {
          "label": "Mitos",
          "text": "Mengerjakan banyak hal sekaligus *lebih cepat*"
        },
        "right": {
          "label": "Fakta",
          "text": "Pindah-pindah tugas *menambah waktu*"
